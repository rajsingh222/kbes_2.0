# Production Environment Variables for Backend (Render)

# GROQ API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# MongoDB Configuration
MONGODB_URI=your_mongodb_connection_string_here

# Email Configuration (SendGrid)
EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_VERIFICATION_API_KEY=your_sendgrid_verification_api_key_here
EMAIL_FROM=admin@spplindia.org
EMAIL_USER=admin@spplindia.org

# Brevo (formerly Sendinblue) Configuration
BREVO_SMTP_USER=your_brevo_smtp_user_here
BREVO_SMTP_PASS=your_brevo_smtp_password_here

# JWT Secret (IMPORTANT: Generate a strong random secret for production)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# CORS Configuration
FRONTEND_URL=https://your-frontend-domain.com

# Server Configuration
PORT=5000
NODE_ENV=production

# Razorpay Payment Configuration (IMPORTANT: Use LIVE keys for production)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
